GROQ_API_KEY=replace_with_your_groq_key
GROQ_MODEL=allam-2-7b
PORT=3002
ADMIN_PASSWORD=replace_with_a_long_random_password
# Optional for GitHub Pages/Netlify. Origins only, no repository path.
# Separate multiple origins with commas. Leave empty for local/full-stack hosting.
STATIC_SITE_ORIGIN=
# Optional: persistent disk location on your Node.js host (single instance only).
# DATA_DIRECTORY=/opt/render/project/src/storage
# Production: private pooled Neon URL. When set, temporary local files are not used.
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# Migration command only: direct URL, without -pooler in the hostname.
# DATABASE_URL_UNPOOLED=postgresql://ROLE:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full
